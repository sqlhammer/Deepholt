; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Deepholt"
config/version="0.0.0"
run/main_scene="uid://p66nsvtkjca"
config/auto_accept_quit=false
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://d2ufv0rd2aoa"

[autoload]

Global="*uid://dhr1etdbio5wj"
TilePrefabRegistry="*res://src/world/tile_prefab_registry.gd"

[debug]

file_logging/max_log_files=30
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=512
window/size/viewport_height=320
window/size/mode=4
window/size/resizable=false
window/size/window_width_override=1280
window/size/window_height_override=800

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

